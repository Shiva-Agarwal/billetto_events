# --- Database (defaults: localhost:5432, current OS user, no password) ---
# DATABASE_HOST=localhost
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres

# --- Billetto (https://billetto.dk -> Organiser -> Integrate -> Developers -> API keys) ---
BILLETTO_API_KEYPAIR=
# BILLETTO_API_BASE_URL=https://billetto.dk/api/v3

# --- Clerk (https://dashboard.clerk.com -> API keys) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: PEM public key for fully networkless JWT verification ("Show JWT public key")
# CLERK_JWT_KEY=
# Comma separated origins allowed in the `azp` claim
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Webhook signing secret (Dashboard -> Webhooks -> endpoint -> Signing secret)
CLERK_WEBHOOK_SIGNING_SECRET=

# In development a missing Billetto keypair / Clerk publishable key switches that integration
# to its in-memory fake. Force explicitly with FAKE_BILLETTO=true|false, FAKE_CLERK=true|false
# (or FAKE_INTEGRATIONS=true for both).

# --- Background jobs ---
# Development default is the in-process :async adapter. Use Sidekiq (needs Redis):
# ACTIVE_JOB_ADAPTER=sidekiq
# REDIS_URL=redis://localhost:6379/0
